/* Dark theme — color overrides only */
QCheckBox {
    color: #E8E5E0;
}

QCheckBox::indicator {
    border-radius: 4px;
    border: 2px solid #4A4742;
    background-color: #262522;
}

QCheckBox::indicator:checked {
    background-color: #B8956A;
    border-color: #B8956A;
}

QCheckBox::indicator:disabled {
    background-color: #1C1C1A;
    border-color: #353330;
}

QCheckBox::indicator:hover {
    border-color: #B8956A;
}

QComboBox {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #262522;
    border: 1px solid #353330;
    border-radius: 8px;
    outline: none;
    selection-background-color: #2E2A24;
    selection-color: #B8956A;
}

QComboBox QAbstractItemView::item {
    border-radius: 4px;
    color: #E8E5E0;
}

QComboBox::drop-down {
    border: none;
}

QComboBox:focus {
    border-color: #B8956A;
    border-width: 2px;
}

QComboBox:hover {
    border-color: #4A4742;
}

QFrame#chartArea {
    background-color: #32312E;
    border: 1px solid #4A4742;
    border-radius: 12px;
}

QFrame#printerCard {
    background-color: #32312E;
    border: 1px solid #4A4742;
    border-radius: 10px;
}

QFrame#printerCard:hover {
    border: 1px solid #5A5550;
}

QFrame#printerCard[compact="false"] QLabel#printName {
    color: #E8E5E0;
}

QFrame#printerCard[compact="false"] QLabel#printPort {
    color: #9A928A;
}

QFrame#sidebar {
    background-color: #1C1C1A;
    border-right: 1px solid #353330;
}

QFrame#statCard {
    background-color: #32312E;
    border: 1px solid #4A4742;
    border-radius: 12px;
}

QFrame#statCard:hover {
    border: 1px solid #5A5550;
    background-color: #353430;
}

QGroupBox {
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 8px;
}

QGroupBox::title {
    background-color: #1C1C1A;
    color: #9A928A;
}

QHeaderView::section {
    background-color: #1C1C1A;
    color: #9A928A;
    border: none;
    border-bottom: 2px solid #353330;
}

QHeaderView::section:hover {
    background-color: #262522;
}

QLabel {
    color: #E8E5E0;
}

QLabel#brandSub {
    color: #9A928A;
}

QLabel#brandTitle {
    color: #E8E5E0;
}

QLabel#chartLabel {
    color: #9A928A;
}

QLabel#data {
    color: #E8E5E0;
}

QLabel#footerText {
    color: #9A928A;
}

QLabel#muted {
    color: #9A928A;
}

QLabel#pageSub {
    color: #9A928A;
}

QLabel#pageTitle {
    color: #E8E5E0;
}

QLabel#printDefaultBadge {
    color: #8B7355;
}

QLabel#printName {
    color: #E8E5E0;
}

QLabel#printPort {
    color: #9A928A;
}

QLabel#sectionHeading {
    color: #E8E5E0;
}

QLabel#sectionLabel {
    color: #6A6560;
}

QLabel#statChange {
    color: #9A928A;
}

QLabel#statLabel {
    color: #9A928A;
}

QLabel#statValue {
    color: #E8E5E0;
}

QLineEdit {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
    selection-background-color: #2E2A24;
    selection-color: #B8956A;
}

QLineEdit:disabled {
    background-color: #1C1C1A;
    color: #6A6560;
}

QLineEdit:focus {
    border-color: #B8956A;
    border-width: 2px;
}

QListWidget {
    background-color: #262522;
    border: 1px solid #353330;
    border-radius: 8px;
    color: #E8E5E0;
    outline: none;
}

QListWidget::item {
    border-radius: 3px;
}

QListWidget::item:hover {
    background-color: #30302C;
}

QListWidget::item:selected {
    background-color: #2E2A24;
    color: #B8956A;
}

QMainWindow, QStackedWidget {
    background-color: #1C1C1A;
}

QMenu {
    background-color: #262522;
    border: 1px solid #353330;
    border-radius: 8px;
}

QMenu::item {
    border-radius: 5px;
    color: #E8E5E0;
}

QMenu::item:selected {
    background-color: #2E2A24;
    color: #B8956A;
}

QMenu::separator {
    background-color: #353330;
}

QProgressBar {
    background-color: #353330;
    border-radius: 3px;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #B8956A;
    border-radius: 3px;
}

QPushButton {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
}

QPushButton#danger {
    background-color: #E86060;
    color: #1C1C1A;
    border: none;
}

QPushButton#danger:hover {
    background-color: #D05050;
}

QPushButton#danger:pressed {
    background-color: #B84545;
}

QPushButton#ghost {
    background-color: transparent;
    color: #B8956A;
    border: 1px solid #353330;
}

QPushButton#ghost:hover {
    background-color: #2E2A24;
    color: #E8E5E0;
    border-color: #4A4742;
}

QPushButton#ghostDanger {
    background-color: transparent;
    color: #E86060;
    border: 1px solid #353330;
}

QPushButton#ghostDanger:hover {
    background-color: #E86060;
    color: #1C1C1A;
    border-color: #E86060;
}

QPushButton#ghostDanger:pressed {
    background-color: #D05050;
    color: #1C1C1A;
    border-color: #D05050;
}

QPushButton#navItem {
    border-radius: 6px;
    color: #9A928A;
    border: none;
}

QPushButton#navItem:hover {
    background-color: #2E2A24;
    color: #C8C0B8;
}

QPushButton#navItem[active="true"] {
    background-color: #2E2A24;
    color: #B8956A;
}

QPushButton#primary {
    background-color: #B8956A;
    color: #1C1C1A;
    border: none;
    border-radius: 6px;
}

QPushButton#primary:disabled {
    background-color: #353330;
    color: #6A6560;
}

QPushButton#primary:hover {
    background-color: #C9A67E;
}

QPushButton#primary:pressed {
    background-color: #A08058;
}

QPushButton#statusPill {
    border-radius: 13px;
    border: 1px solid #353330;
    color: #9A928A;
}

QPushButton#statusPill:hover {
    background-color: #30302C;
    color: #E8E5E0;
    border-color: #4A4742;
}

QPushButton#statusPill:pressed {
    background-color: #1C1C1A;
}

QPushButton#statusPillSuccess {
    border-radius: 13px;
    border: none;
    background-color: #6B8F6B;
    color: #1C1C1A;
}

QPushButton#statusPillSuccess:disabled {
    background-color: #353330;
    color: #6A6560;
}

QPushButton#statusPillSuccess:hover {
    background-color: #7DA07D;
}

QPushButton#statusPillSuccess:pressed {
    background-color: #5A7D5A;
}

QPushButton:disabled {
    background-color: #1C1C1A;
    color: #6A6560;
    border-color: #353330;
}

QPushButton:focus {
    outline: none;
    border-color: #B8956A;
    border-width: 2px;
}

QPushButton:hover {
    background-color: #30302C;
    border-color: #4A4742;
}

QPushButton:pressed {
    background-color: #1C1C1A;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea#dashboardScroll {
    border: none;
    background-color: transparent;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #4A4742;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5A5550;
}

QScrollBar::handle:vertical {
    background-color: #4A4742;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5A5550;
}

QScrollBar:horizontal {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    border: none;
}

QSpinBox {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background-color: transparent;
    border-radius: 2px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #30302C;
}

QSpinBox:focus {
    border-color: #B8956A;
    border-width: 2px;
}

QTableView {
    background-color: #262522;
    alternate-background-color: #1C1C1A;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 8px;
    gridline-color: #30302C;
    selection-background-color: #2E2A24;
    selection-color: #B8956A;
}

QTableView::item:hover {
    background-color: #30302C;
}

QTableView::item:selected {
    background-color: #2E2A24;
    color: #B8956A;
}

QToolTip {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
}

QWidget#sidebarFooter {
    border-top: 1px solid #353330;
}

QWidget#statusBar {
    background-color: #262522;
    border-top: 1px solid #353330;
}

QWidget#statusBar QLabel#statusText {
    color: #9A928A;
}

/* Setup wizard */
QDialog#setupWizard {
    background-color: #1C1C1A;
}

QFrame#wizardNav {
    background-color: #262522;
    border-top: 1px solid #353330;
}