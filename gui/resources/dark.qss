/* ============================================================
   iOS 云打印服务器 — Dark Theme (Porcelain Dark)
   Warm dark, bronze accents. Like a dimly lit study.
   ============================================================ */

/* ---- Main Window ---- */
QMainWindow, QStackedWidget {
    background-color: #1C1C1A;
}

/* ---- Labels ---- */
QLabel {
    color: #E8E5E0;
    background: transparent;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
}

QLabel#muted { color: #9A928A; font-size: 12px; }

QLabel#data {
    font-family: Consolas, "Cascadia Code", "Courier New", monospace;
    font-size: 13px;
    color: #E8E5E0;
}

/* ---- Status Bar (bottom) ---- */
QWidget#statusBar {
    background-color: #262522;
    border-top: 1px solid #353330;
}

QWidget#statusBar QLabel#statusText {
    font-family: Consolas, "Cascadia Code", "Courier New", monospace;
    font-size: 12px;
    color: #9A928A;
    font-weight: 500;
}

/* Status Pill Buttons */
QPushButton#statusPill {
    height: 26px;
    padding: 0 14px;
    border-radius: 13px;
    border: 1px solid #353330;
    background: transparent;
    font-size: 11px;
    font-weight: 500;
    color: #9A928A;
    min-height: 26px;
}

QPushButton#statusPill:hover {
    background-color: #30302C;
    color: #E8E5E0;
    border-color: #4A4742;
}

QPushButton#statusPill:pressed {
    background-color: #1C1C1A;
}

QPushButton#statusPillSuccess {
    height: 26px;
    padding: 0 14px;
    border-radius: 13px;
    border: none;
    background-color: #6B8F6B;
    font-size: 11px;
    font-weight: 500;
    color: #1C1C1A;
    min-height: 26px;
}

QPushButton#statusPillSuccess:hover {
    background-color: #7DA07D;
}

QPushButton#statusPillSuccess:pressed {
    background-color: #5A7D5A;
}

QPushButton#statusPillSuccess:disabled {
    background-color: #353330;
    color: #6A6560;
}

/* ---- Sidebar ---- */
QFrame#sidebar {
    background-color: #1C1C1A;
    border-right: 1px solid #353330;
}

/* Brand */
QLabel#brandTitle {
    font-family: "Newsreader", "EB Garamond", Georgia, "Times New Roman", serif;
    font-size: 14px;
    font-weight: 600;
    color: #E8E5E0;
    letter-spacing: 0.5px;
}

QLabel#brandSub {
    font-size: 11px;
    font-weight: 400;
    color: #9A928A;
    letter-spacing: 0.3px;
}

/* Section label */
QLabel#sectionLabel {
    padding: 14px 14px 4px;
    font-size: 10px;
    font-weight: 600;
    color: #6A6560;
    letter-spacing: 0.8px;
}

/* Nav items */
QPushButton#navItem {
    padding: 9px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: #9A928A;
    background: transparent;
    border: none;
    text-align: left;
    padding-left: 14px;
}

QPushButton#navItem:hover {
    background-color: #2E2A24;
    color: #C8C0B8;
}

QPushButton#navItem[active="true"] {
    background-color: #2E2A24;
    color: #B8956A;
    font-weight: 600;
}

/* Sidebar footer */
QWidget#sidebarFooter {
    border-top: 1px solid #353330;
    margin: 0 12px;
}

QLabel#footerDot {
    font-size: 10px;
    color: #6B8F6B;
}

QLabel#footerText {
    font-size: 11px;
    color: #9A928A;
    font-weight: 500;
}

/* ---- Page Title (Dashboard) ---- */
QLabel#pageTitle {
    font-family: "Newsreader", "EB Garamond", Georgia, "Times New Roman", serif;
    font-size: 28px;
    font-weight: 500;
    color: #E8E5E0;
    letter-spacing: 0.5px;
}

QLabel#pageSub {
    font-size: 13px;
    color: #9A928A;
    font-weight: 400;
}

/* Section Heading */
QLabel#sectionHeading {
    font-family: "Newsreader", "EB Garamond", Georgia, "Times New Roman", serif;
    font-size: 17px;
    font-weight: 500;
    color: #E8E5E0;
}

/* ---- KPI Stat Cards ---- */
QFrame#statCard {
    background-color: #262522;
    border: none;
    border-radius: 12px;
    padding: 0px;
}

QFrame#statCard:hover {
    border: 1px solid #4A4742;
    background-color: #2A2926;
}

QLabel#statLabel {
    font-size: 11px;
    font-weight: 600;
    color: #9A928A;
    letter-spacing: 0.6px;
    margin-bottom: 2px;
}

QLabel#statValue {
    font-family: "Newsreader", "EB Garamond", Georgia, "Times New Roman", serif;
    font-size: 30px;
    font-weight: 600;
    color: #E8E5E0;
    letter-spacing: -0.5px;
    line-height: 1.1;
}

QLabel#statChange {
    font-size: 11px;
    color: #9A928A;
    font-weight: 500;
    margin-top: 2px;
}

/* ---- Chart Area ---- */
QFrame#chartArea {
    background-color: #262522;
    border: none;
    border-radius: 12px;
    min-height: 160px;
}

QLabel#chartLabel {
    font-size: 12px;
    font-weight: 500;
    color: #9A928A;
}

/* ---- Printer Cards ---- */
QFrame#printerCard {
    background-color: #262522;
    border: none;
    border-radius: 10px;
    min-height: 56px;
}

QFrame#printerCard:hover {
    border: 1px solid #4A4742;
}

QFrame#printerCard[compact="true"] {
    min-height: 48px;
}

QFrame#printerCard[compact="false"] {
    min-height: 180px;
}

/* ---- PushButton ---- */
QPushButton {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
    padding: 6px 18px;
    font-size: 13px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30302C;
    border-color: #4A4742;
}

QPushButton:pressed {
    background-color: #1C1C1A;
}

QPushButton:disabled {
    background-color: #1C1C1A;
    color: #6A6560;
    border-color: #353330;
}

/* Primary */
QPushButton#primary {
    background-color: #B8956A;
    color: #1C1C1A;
    border: none;
    font-weight: 600;
}

QPushButton#primary:hover { background-color: #C9A67E; }
QPushButton#primary:pressed { background-color: #A08058; }
QPushButton#primary:disabled { background-color: #353330; color: #6A6560; }

/* Danger */
QPushButton#danger {
    background-color: #E86060;
    color: #1C1C1A;
    border: none;
}

QPushButton#danger:hover { background-color: #D05050; }
QPushButton#danger:pressed { background-color: #B84545; }

/* Ghost */
QPushButton#ghost {
    background-color: transparent;
    color: #B8956A;
    border: 1px solid #353330;
}

QPushButton#ghost:hover { background-color: #2E2A24; color: #E8E5E0; border-color: #4A4742; }

/* StatefulButton */
StatefulButton {
    background-color: #B8956A;
    color: #1C1C1A;
    border: none;
    border-radius: 6px;
    padding: 6px 18px;
    font-size: 13px;
    min-height: 20px;
    font-weight: 600;
}

StatefulButton:hover { background-color: #C9A67E; }
StatefulButton:pressed { background-color: #A08058; }

/* ---- QLineEdit ---- */
QLineEdit {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #2E2A24;
    selection-color: #B8956A;
}

QLineEdit:focus { border-color: #B8956A; border-width: 2px; padding: 5px 9px; }
QLineEdit:disabled { background-color: #1C1C1A; color: #6A6560; }

/* ---- QComboBox ---- */
QComboBox {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
    padding: 6px 30px 6px 10px;
    font-size: 13px;
    min-width: 80px;
}

QComboBox:hover { border-color: #4A4742; }
QComboBox:focus { border-color: #B8956A; border-width: 2px; padding: 5px 29px 5px 9px; }

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
}

QComboBox::down-arrow { width: 8px; height: 8px; }

QComboBox QAbstractItemView {
    background-color: #262522;
    border: 1px solid #353330;
    border-radius: 8px;
    padding: 5px;
    outline: none;
    selection-background-color: #2E2A24;
    selection-color: #B8956A;
}

QComboBox QAbstractItemView::item {
    padding: 7px 10px;
    border-radius: 4px;
    min-height: 22px;
    color: #E8E5E0;
}

/* ---- QSpinBox ---- */
QSpinBox {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
    padding: 6px 26px 6px 10px;
    font-size: 13px;
}

QSpinBox:focus { border-color: #B8956A; border-width: 2px; padding: 5px 25px 5px 9px; }

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: none;
    background-color: transparent;
    border-radius: 2px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #30302C;
}

QSpinBox::up-arrow { width: 7px; height: 7px; }
QSpinBox::down-arrow { width: 7px; height: 7px; }

/* ---- QCheckBox ---- */
QCheckBox { color: #E8E5E0; font-size: 13px; spacing: 8px; }

QCheckBox::indicator {
    width: 18px; height: 18px; border-radius: 4px;
    border: 2px solid #4A4742; background-color: #262522;
}

QCheckBox::indicator:checked {
    background-color: #B8956A; border-color: #B8956A;
}

QCheckBox::indicator:hover { border-color: #B8956A; }
QCheckBox::indicator:disabled { background-color: #1C1C1A; border-color: #353330; }

/* ---- QTableView ---- */
QTableView {
    background-color: #262522;
    alternate-background-color: #1C1C1A;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 8px;
    gridline-color: #30302C;
    selection-background-color: #2E2A24;
    selection-color: #B8956A;
    font-size: 13px;
}

QTableView::item { padding: 7px 10px; min-height: 32px; }
QTableView::item:hover { background-color: #30302C; }
QTableView::item:selected { background-color: #2E2A24; color: #B8956A; }

QHeaderView::section {
    background-color: #1C1C1A;
    color: #9A928A;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.5px;
    padding: 9px 10px;
    border: none;
    border-bottom: 2px solid #353330;
}

QHeaderView::section:hover { background-color: #262522; }

/* ---- QProgressBar ---- */
QProgressBar {
    background-color: #353330;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    font-size: 11px;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #B8956A;
    border-radius: 3px;
}

/* ---- QScrollBar (Vertical) ---- */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #4A4742;
    border-radius: 5px;
    min-height: 28px;
    margin: 3px;
}

QScrollBar::handle:vertical:hover { background-color: #5A5550; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; border: none; }

/* ---- QScrollBar (Horizontal) ---- */
QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #4A4742;
    border-radius: 5px;
    min-width: 28px;
    margin: 3px;
}

QScrollBar::handle:horizontal:hover { background-color: #5A5550; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; border: none; }

/* ---- QGroupBox ---- */
QGroupBox {
    font-weight: 500;
    font-size: 13px;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 8px;
    margin-top: 12px;
    padding: 20px 14px 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: #1C1C1A;
    color: #9A928A;
}

/* ---- QToolTip ---- */
QToolTip {
    background-color: #262522;
    color: #E8E5E0;
    border: 1px solid #353330;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ---- QMenu ---- */
QMenu {
    background-color: #262522;
    border: 1px solid #353330;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 22px;
    border-radius: 5px;
    font-size: 13px;
    color: #E8E5E0;
}

QMenu::item:selected { background-color: #2E2A24; color: #B8956A; }
QMenu::separator { height: 1px; background-color: #353330; margin: 3px 8px; }

/* ---- QScrollArea ---- */
QScrollArea { border: none; background-color: transparent; }
QScrollArea#dashboardScroll { border: none; background-color: transparent; }

/* ---- QListWidget (log viewer) ---- */
QListWidget {
    background-color: #262522;
    border: 1px solid #353330;
    border-radius: 8px;
    color: #E8E5E0;
    font-family: Consolas, "Cascadia Code", "Courier New", monospace;
    font-size: 12px;
    padding: 4px;
    outline: none;
}

QListWidget::item { padding: 4px 8px; border-radius: 3px; }
QListWidget::item:hover { background-color: #30302C; }
QListWidget::item:selected { background-color: #2E2A24; color: #B8956A; }