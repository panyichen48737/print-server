/* Light theme — color overrides only */
QCheckBox {
    color: #1C1917;
}

QCheckBox::indicator {
    border-radius: 4px;
    border: 2px solid #D0C8BE;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #8B7355;
    border-color: #8B7355;
}

QCheckBox::indicator:disabled {
    background-color: #F5F0EB;
    border-color: #E5DDD5;
}

QCheckBox::indicator:hover {
    border-color: #8B7355;
}

QComboBox {
    background-color: #FFFFFF;
    color: #1C1917;
    border: 1px solid #E5DDD5;
    border-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5DDD5;
    border-radius: 8px;
    outline: none;
    selection-background-color: #EDE6DD;
    selection-color: #1C1917;
}

QComboBox QAbstractItemView::item {
    border-radius: 4px;
    color: #1C1917;
}

QComboBox::drop-down {
    border: none;
}

QComboBox:focus {
    border-color: #8B7355;
    border-width: 2px;
}

QComboBox:hover {
    border-color: #D0C8BE;
}

QFrame#chartArea {
    background-color: #FFFFFF;
    border: 1px solid #E5DDD5;
    border-radius: 12px;
}

QFrame#printerCard {
    background-color: #FFFFFF;
    border: 1px solid #E5DDD5;
    border-radius: 10px;
}

QFrame#printerCard:hover {
    border: 1px solid #D0C8BE;
}

QFrame#printerCard[compact="false"] QLabel#printName {
    color: #1C1917;
}

QFrame#printerCard[compact="false"] QLabel#printPort {
    color: #8A8178;
}

QFrame#sidebar {
    background-color: #F5F0EB;
    border-right: 1px solid #EFE9E2;
}

QFrame#statCard {
    background-color: #FFFFFF;
    border: 1px solid #E5DDD5;
    border-radius: 12px;
}

QFrame#statCard:hover {
    border: 1px solid #D0C8BE;
    background-color: #FDFDFB;
}

QGroupBox {
    color: #1C1917;
    border: 1px solid #E5DDD5;
    border-radius: 8px;
}

QGroupBox::title {
    background-color: #FAFAF8;
    color: #6B6258;
}

QHeaderView::section {
    background-color: #FAFAF8;
    color: #8A8178;
    border: none;
    border-bottom: 2px solid #E5DDD5;
}

QHeaderView::section:hover {
    background-color: #F0ECE5;
}

QLabel {
    color: #1C1917;
}

QLabel#brandSub {
    color: #8A8178;
}

QLabel#brandTitle {
    color: #1C1917;
}

QLabel#chartLabel {
    color: #8A8178;
}

QLabel#data {
    color: #1C1917;
}

QLabel#footerText {
    color: #8A8178;
}

QLabel#muted {
    color: #8A8178;
}

QLabel#pageSub {
    color: #8A8178;
}

QLabel#pageTitle {
    color: #1C1917;
}

QLabel#printDefaultBadge {
    color: #8B7355;
}

QLabel#printName {
    color: #1C1917;
}

QLabel#printPort {
    color: #8A8178;
}

QLabel#sectionHeading {
    color: #1C1917;
}

QLabel#sectionLabel {
    color: #B0A89F;
}

QLabel#statChange {
    color: #8A8178;
}

QLabel#statLabel {
    color: #8A8178;
}

QLabel#statValue {
    color: #1C1917;
}

QLineEdit {
    background-color: #FFFFFF;
    color: #1C1917;
    border: 1px solid #E5DDD5;
    border-radius: 6px;
    selection-background-color: #E8DFD4;
    selection-color: #1C1917;
}

QLineEdit:disabled {
    background-color: #F5F0EB;
    color: #B0A89F;
}

QLineEdit:focus {
    border-color: #8B7355;
    border-width: 2px;
}

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5DDD5;
    border-radius: 8px;
    color: #1C1917;
    outline: none;
}

QListWidget::item {
    border-radius: 3px;
}

QListWidget::item:hover {
    background-color: #F5F0EB;
}

QListWidget::item:selected {
    background-color: #EDE6DD;
    color: #1C1917;
}

QMainWindow, QStackedWidget {
    background-color: #F2F0EB;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5DDD5;
    border-radius: 8px;
}

QMenu::item {
    border-radius: 5px;
    color: #1C1917;
}

QMenu::item:selected {
    background-color: #EDE6DD;
    color: #8B7355;
}

QMenu::separator {
    background-color: #E5DDD5;
}

QProgressBar {
    background-color: #E5DDD5;
    border-radius: 3px;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #8B7355;
    border-radius: 3px;
}

QPushButton {
    background-color: #FFFFFF;
    color: #1C1917;
    border: 1px solid #E5DDD5;
    border-radius: 6px;
}

QPushButton#danger {
    background-color: #C53A3A;
    color: #FFFFFF;
    border: none;
}

QPushButton#danger:hover {
    background-color: #A82828;
}

QPushButton#danger:pressed {
    background-color: #8F2222;
}

QPushButton#ghost {
    background-color: transparent;
    color: #8B7355;
    border: 1px solid #E5DDD5;
}

QPushButton#ghost:hover {
    background-color: #F5F0EB;
    color: #1C1917;
    border-color: #D0C8BE;
}

QPushButton#ghostDanger {
    background-color: transparent;
    color: #C53A3A;
    border: 1px solid #E5DDD5;
}

QPushButton#ghostDanger:hover {
    background-color: #C53A3A;
    color: #FFFFFF;
    border-color: #C53A3A;
}

QPushButton#ghostDanger:pressed {
    background-color: #A82828;
    color: #FFFFFF;
    border-color: #A82828;
}

QPushButton#navItem {
    border-radius: 6px;
    color: #8A8178;
    border: none;
}

QPushButton#navItem:hover {
    background-color: #EDE6DD;
    color: #1C1917;
}

QPushButton#navItem[active="true"] {
    background-color: #E5DDD5;
    color: #8B7355;
}

QPushButton#primary {
    background-color: #8B7355;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
}

QPushButton#primary:disabled {
    background-color: #D0C8BE;
    color: #F5F0EB;
}

QPushButton#primary:hover {
    background-color: #7A6248;
}

QPushButton#primary:pressed {
    background-color: #5A4A35;
}

QPushButton#statusPill {
    border-radius: 13px;
    border: 1px solid #E5DDD5;
    color: #8A8178;
}

QPushButton#statusPill:hover {
    background-color: #F5F0EB;
    color: #1C1917;
    border-color: #D0C8BE;
}

QPushButton#statusPill:pressed {
    background-color: #EDE6DD;
}

QPushButton#statusPillSuccess {
    border-radius: 13px;
    border: none;
    background-color: #6B8F6B;
    color: #FFFFFF;
}

QPushButton#statusPillSuccess:disabled {
    background-color: #D0C8BE;
    color: #F5F0EB;
}

QPushButton#statusPillSuccess:hover {
    background-color: #5D7E5D;
}

QPushButton#statusPillSuccess:pressed {
    background-color: #4E6D4E;
}

QPushButton:disabled {
    background-color: #F5F0EB;
    color: #B0A89F;
    border-color: #E5DDD5;
}

QPushButton:focus {
    outline: none;
    border-color: #8B7355;
    border-width: 2px;
}

QPushButton:hover {
    background-color: #F5F0EB;
    border-color: #D0C8BE;
}

QPushButton:pressed {
    background-color: #EDE6DD;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea#dashboardScroll {
    border: none;
    background-color: transparent;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #D0C8BE;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #B0A89F;
}

QScrollBar::handle:vertical {
    background-color: #D0C8BE;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B0A89F;
}

QScrollBar:horizontal {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    border: none;
}

QSpinBox {
    background-color: #FFFFFF;
    color: #1C1917;
    border: 1px solid #E5DDD5;
    border-radius: 6px;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background-color: transparent;
    border-radius: 2px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #F5F0EB;
}

QSpinBox:focus {
    border-color: #8B7355;
    border-width: 2px;
}

QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FAFAF8;
    color: #1C1917;
    border: 1px solid #E5DDD5;
    border-radius: 8px;
    gridline-color: #EFE9E2;
    selection-background-color: #EDE6DD;
    selection-color: #1C1917;
}

QTableView::item:hover {
    background-color: #F5F0EB;
}

QTableView::item:selected {
    background-color: #EDE6DD;
    color: #1C1917;
}

QToolTip {
    background-color: #1C1917;
    color: #FAFAF8;
    border: none;
    border-radius: 6px;
}

QWidget#sidebarFooter {
    border-top: 1px solid #EFE9E2;
}

QWidget#statusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5DDD5;
}

QWidget#statusBar QLabel#statusText {
    color: #8A8178;
}