{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "enabledManagers": ["pip_requirements", "pep621", "gomod", "github-actions", "pre-commit", "custom.regex"],
  "assignees": ["panyichen48737"],
  "schedule": ["before 9am on Monday"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "separateMinorPatch": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeStrategy": "squash"
  },
  "packageRules": [
    {
      "matchManagers": ["pip_requirements", "pep621"],
      "matchUpdateTypes": ["patch"],
      "description": "Automerge patch updates for Python deps",
      "automerge": true,
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": ["pip_requirements", "pep621"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "commitMessagePrefix": "chore(deps)",
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci",
      "addLabels": ["ci"],
      "automerge": true,
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": ["gomod"],
      "description": "Automerge Go module updates (minor + patch)",
      "automerge": true,
      "automergeStrategy": "squash",
      "commitMessagePrefix": "chore(deps)",
      "commitMessageTopic": "Go module",
      "addLabels": ["dependencies"]
    },
    {
      "matchManagers": ["pre-commit"],
      "description": "Automerge pre-commit hook updates (minor + patch)",
      "automerge": true,
      "automergeStrategy": "squash",
      "commitMessagePrefix": "chore(deps)",
      "commitMessageTopic": "pre-commit hook",
      "addLabels": ["dependencies"]
    },
    {
      "matchDepNames": ["python-version"],
      "commitMessagePrefix": "ci",
      "commitMessageTopic": "Python version",
      "addLabels": ["ci"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": ["python-version:\\s*['\"]?(?<currentValue>\\d+\\.\\d+)['\"]?"],
      "depNameTemplate": "python-version",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "semver"
    }
  ]
}