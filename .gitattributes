# Normalize line endings and encoding
* text=auto

# NSIS needs UTF-8 with BOM for Chinese character support
*.nsi text eol=crlf working-tree-encoding=UTF-8-BOM
*.nsh text eol=crlf working-tree-encoding=UTF-8-BOM

# Shell scripts need LF endings
*.sh text eol=lf

# Python
*.py text diff=python

# Go
*.go text

# Binary files
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.zip binary