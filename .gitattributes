# Normalize line endings and encoding
* text=auto

# NSIS files (UTF-8 with BOM for Chinese character support)
*.nsi text eol=crlf
*.nsh text eol=crlf

# Shell scripts need LF endings
*.sh text eol=lf

# Python
*.py text diff=python

# Go
*.go text

# Binary files
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.zip binary